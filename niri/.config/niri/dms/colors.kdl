layout {
    background-color "transparent"

    focus-ring {
        active-color   "#e9c16c"
        inactive-color "#998f80"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e9c16c"
        inactive-color "#998f80"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e9c16c"
        inactive-color "#998f80"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e9c16c80"
    }
}

/-recent-windows {
    highlight {
        active-color   "#5b4300"
        urgent-color   "#ffb4ab"
    }
}